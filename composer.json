{
    "name": "kraftdo/laravel-kraftdo-shared",
    "description": "Código compartido del ecosistema KraftDo (onboarding, RUT, personas, cliente de integración entre sistemas).",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "kraftdo"
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-activitylog": "^5.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "spatie/laravel-permission": "^6.0|^7.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Para Auditoria\\RolePolicy, la política del Resource de roles del panel. Opcional: el paquete autocarga sin él."
    },
    "autoload": {
        "psr-4": {
            "Kraftdo\\Shared\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kraftdo\\Shared\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kraftdo\\Shared\\KraftdoSharedServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "post-install-cmd": [
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ]
    }
}
